{
    "name": "ympact/laravel-icon-registry",
    "description": "Package description",
    "keywords": [
        "laravel",
        "livewire",
        "components"
    ],
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6.15",
        "orchestra/testbench": "^10.12|^11.3",
        "pestphp/pest": "^4.7|^5.2",
        "pestphp/pest-plugin-browser": "^4.3|^5.0",
        "pestphp/pest-plugin-laravel": "^4.1|^5.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5|^13.3"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ympact\\LaravelIconRegistry\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ympact\\LaravelIconRegistry\\LaravelIconRegistryServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/pest",
            "npm test --if-present"
        ],
        "test:browser": [
            "npx playwright install chromium",
            "./vendor/bin/pest --testsuite=Browser"
        ],
        "lint": [
            "./vendor/bin/pint"
        ],
        "analyse": [
            "./vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "authors": [
        {
            "name": "Maurits",
            "email": "maurits@ympact-technologies.nl"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
